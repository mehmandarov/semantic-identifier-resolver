{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Lookup state",
  "description": "Body of GET /api/lookup/results/{requestHash}: the state of one lookup request. A lookup is done only when every worker that claimed the current occurrence (matching requestID) has replied or failed; it is error when all of them failed. The status field selects which extra fields are present: done carries results (the distinct reply elements aggregated across workers) and resultsByWorker (one {worker, at, reply, requestID} block per answering worker, the provenance view); error and timed-out carry detail; in_progress, timed-out and error may carry partial results/resultsByWorker/failuresByWorker. claimedBy lists every pick-up of the request by a worker, across retries.",
  "type": "object",
  "required": ["requestID", "requestHash", "id", "context", "status"],
  "properties": {
    "requestID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requestHash": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "context": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "done", "error", "timed-out"]
    },
    "claimedBy": {
      "type": "array",
      "items": { "$ref": "#/definitions/claim" }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/definitions/resultElement" }
    },
    "resultsByWorker": {
      "type": "array",
      "items": { "$ref": "#/definitions/workerReply" }
    },
    "failuresByWorker": {
      "type": "array",
      "items": { "$ref": "#/definitions/workerFailure" }
    },
    "resolvedBy": { "type": "string", "minLength": 1 },
    "resolvedAt": { "type": "string", "minLength": 1 },
    "detail": { "type": "string" }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "description": "pending: accepted (or reset for retry), nothing collected yet",
      "properties": { "status": { "enum": ["pending"] } },
      "not": { "anyOf": [ { "required": ["results"] }, { "required": ["detail"] } ] }
    },
    {
      "description": "in_progress: claimed; may already carry partial results",
      "properties": { "status": { "enum": ["in_progress"] } },
      "not": { "required": ["detail"] }
    },
    {
      "description": "done: every claimed worker responded, at least one with results",
      "properties": { "status": { "enum": ["done"] } },
      "required": ["results", "resultsByWorker", "resolvedBy", "resolvedAt"]
    },
    {
      "description": "error: every claimed worker responded, all failed",
      "properties": { "status": { "enum": ["error"] } },
      "required": ["detail"]
    },
    {
      "description": "timed-out: not all claimed workers completed in time; partial results may be present",
      "properties": { "status": { "enum": ["timed-out"] } },
      "required": ["detail"]
    }
  ],
  "definitions": {
    "claim": {
      "type": "object",
      "required": ["worker", "at", "requestID"],
      "properties": {
        "worker": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "minLength": 1 },
        "requestID": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resultElement": {
      "type": "object",
      "required": ["id", "context", "relationship"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workerReply": {
      "type": "object",
      "required": ["worker", "at", "reply", "requestID"],
      "properties": {
        "worker": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "minLength": 1 },
        "requestID": { "type": "string", "minLength": 1 },
        "reply": {
          "type": "array",
          "items": { "$ref": "#/definitions/resultElement" }
        }
      },
      "additionalProperties": false
    },
    "workerFailure": {
      "type": "object",
      "required": ["worker", "at", "detail", "requestID"],
      "properties": {
        "worker": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "requestID": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
